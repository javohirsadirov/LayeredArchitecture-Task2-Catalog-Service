		<ProjectReference Include="..\LayeredArchitecture-Task2-Catalog-Service.MessageQueue\LayeredArchitecture-Task2-Catalog-Service.MessageQueue.csproj" />
		<ProjectReference Include="..\LayeredArchitecture-Task2-Catalog-Service.Repository\LayeredArchitecture-Task2-Catalog-Service.Repository.csproj" />
	</ItemGroup>

</Project>

